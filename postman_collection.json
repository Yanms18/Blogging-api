{
  "info": {
    "name": "Blogging API",
    "description": "Collection of API endpoints for the Blogging API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sign Up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signup"]
        }
      }
    },
    {
      "name": "Log In",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Create Blog",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My First Blog\",\n  \"description\": \"This is a description of my first blog.\",\n  \"tags\": [\"tag1\", \"tag2\"],\n  \"body\": \"This is the body of my first blog. It contains detailed information about the topic.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/blogs/create-post",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "create-post"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonResponse = pm.response.json();",
              "pm.environment.set('blogId', jsonResponse.data._id);"
              ,
              "const encodedTitle = encodeURIComponent(jsonResponse.data.title);",
              "pm.environment.set('title', encodedTitle);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Published Blogs",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/blogs/all-posts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "all-posts"]
        }
      }
    },
    {
      "name": "Search Blogs",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/blogs/all-posts?search={{keyword}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "all-posts"],
          "query": [
            {
              "key": "search",
              "value": "{{keyword}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Blog by Title",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/blogs/single-post?title={{title}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "single-post"],
          "query": [
            {
              "key": "title",
              "value": "{{title}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Blog by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "{{blogId}}"]
        }
      }
    },
    {
      "name": "Update Blog by Title",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newTitle\": \"Updated Blog Title\",\n  \"description\": \"Updated description.\",\n  \"tags\": [\"tag1\", \"tag3\"],\n  \"body\": \"Updated body of the blog.\",\n  \"state\": \"published\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/blogs/title/{{title}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "title", "{{title}}"]
        }
      }
    },
    {
      "name": "Delete Blog",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "{{blogId}}"]
        }
      }
    },
    {
      "name": "Get User Blogs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/blogs/user/blogs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "blogs", "user", "blogs"]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.sendRequest({",
          "  url: pm.environment.get('baseUrl') + '/api/auth/login',",
          "  method: 'POST',",
          "  header: {",
          "    'Content-Type': 'application/json'",
          "  },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({",
          "      email: pm.environment.get('email'),",
          "      password: pm.environment.get('password')",
          "    })",
          "  }",
          "}, function (err, res) {",
          "  if (err) {",
          "    console.log(err);",
          "  } else {",
          "    const jsonResponse = res.json();",
          "    pm.environment.set('token', jsonResponse.token);",
          "  }",
          "});"
        ]
      }
    }
  ]
}